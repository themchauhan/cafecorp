rules_version = '2';

// Every tenant-scoped collection is read-only from the client, scoped
// by the `tenantId`/`role` custom claims on the caller's ID token.
// ALL writes go through a Next.js Server Action using the Admin SDK,
// which bypasses these rules by design — see CLAUDE.md hard rule #3
// and src/lib/auth/session.ts. Collections not yet built (orders,
// menuItems, etc.) fall through to the deny-all catch-all at the
// bottom until their own phase adds an explicit rule.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tokenRole() {
      return request.auth.token.role;
    }

    function tokenTenantId() {
      return request.auth.token.tenantId;
    }

    function isSuperAdmin() {
      return signedIn() && tokenRole() == 'SUPER_ADMIN';
    }

    function isTenantMember(tenantId) {
      return signedIn() && tokenTenantId() == tenantId;
    }

    function hasTenantRole(tenantId, roles) {
      return isTenantMember(tenantId) && tokenRole() in roles;
    }

    // SUPER_ADMIN registry — a separate top-level collection, not a
    // nullable tenantId on profiles (CLAUDE.md / BRIEF.md).
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid && isSuperAdmin();
      allow write: if false;

      // SUPER_ADMIN's TOTP secret (Phase 1c) — same rule as the
      // tenant-scoped one below: never readable/writable by anyone,
      // including its own owner.
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // SUPER_ADMIN-only billing records for tenant subscriptions
    // (Phase 7). No client path needs this at all yet.
    match /subscriptionPayments/{paymentId} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isSuperAdmin();
      allow write: if false;

      match /profiles/{uid} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if false;

        // TOTP secret (Phase 1c). Never readable or writable from the
        // client under any circumstance, including by its own owner.
        match /private/{doc} {
          allow read, write: if false;
        }
      }

      match /auditLogs/{logId} {
        allow read: if hasTenantRole(tenantId, ['ADMIN']) || isSuperAdmin();
        allow write: if false;
      }

      // Phase 2: readable by any tenant member (STAFF needs these to
      // take orders in Phase 3); writes are ADMIN-only Server Actions.
      match /menuCategories/{categoryId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if false;
      }

      match /menuItems/{itemId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if false;
      }

      // Phase 3: readable by any tenant member — STAFF need this for
      // the order-taking screen and the live kitchen board
      // (onSnapshot). Writes are ADMIN/STAFF Server Actions only.
      match /orders/{orderId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if false;
      }

      // Phase 4: revenue data — ADMIN/SUPER_ADMIN only (same
      // visibility as auditLogs), not STAFF. Written only by the
      // billing Server Action, in the same transaction as the order
      // write that produced it.
      match /dailySummaries/{dateKey} {
        allow read: if hasTenantRole(tenantId, ['ADMIN']) || isSuperAdmin();
        allow write: if false;
      }

      // Phase 5: readable by any tenant member (STAFF need these for
      // order creation and the table-status board). Writes are
      // ADMIN-only Server Actions.
      match /cafeTables/{tableId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if false;
      }
    }

    // Deny-by-default safety net for every collection not explicitly
    // listed above (subscriptionPayments's tenant-side mirror if any,
    // ... land with their own phase).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
